#!/bin/sh
# Run any OpenGL program with wireframe rendering forced on.
# Usage: ./wireframe-run <program> [args...]
set -e

DIR="$(cd "$(dirname "$0")" && pwd)"
LIB="$DIR/libglwireframe.so"

if [ ! -f "$LIB" ]; then
    echo "wireframe-run: $LIB not found — run 'make' first" >&2
    exit 1
fi

if [ $# -eq 0 ]; then
    echo "Usage: $0 <program> [args...]" >&2
    exit 1
fi

LD_PRELOAD="$LIB${LD_PRELOAD:+:$LD_PRELOAD}" exec "$@"
