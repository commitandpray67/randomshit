# --- The studio host (VPS). Copy to .env on the server and fill in. ---
# See DEPLOY-VPS.md.

# This host's own name. DNS for it must point at the server before Caddy can
# get a certificate.
DOMAIN=studio.steamfriends.xyz

# This host's own URL, NOT the value from Vercel. Steam sends people back to
# it after login, and the studio shows it as the browser-source URL.
APP_URL=https://studio.steamfriends.xyz

# Where every non-studio page is sent.
MAIN_URL=https://steamfriends.xyz

# Shown as "edge" on /diag, so you can tell this host from Vercel.
SERVER_NAME=vps

# --- Copy these from Vercel > Project > Settings > Environment Variables ---

# The same database the main site uses. Both hosts must share it.
DATABASE_URL=
# Neon's *direct* endpoint (no "-pooler" in the host name). Live updates use
# LISTEN, which a pooler silently drops.
DATABASE_URL_UNPOOLED=

SESSION_SECRET=
STEAM_API_KEY=
POGLY_ALLOWED_STEAM_IDS=
SEVENTV_DEFAULT_CHANNEL=juntella
STUDIO_PREVIEW_CHANNEL=juntella
