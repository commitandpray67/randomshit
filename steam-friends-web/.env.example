# --- Copy to .env.local and fill in ---

# Your Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Postgres connection string (Supabase, Neon, or local).
# e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Public base URL of this app. Used to build the Steam OpenID return URL.
# Local dev: http://localhost:3000   Production: https://your-domain.com
APP_URL=http://localhost:3000

# Random secret used to sign the session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Shared secret the cron scheduler sends as `Authorization: Bearer <this>`
# to hit /api/cron/poll. Generate with:  openssl rand -hex 32
CRON_SECRET=

# --- ELO TERRORISTS extension ---
# FACEIT Data API key (server-side): https://developers.faceit.com → API Keys.
# Used to resolve nicknames → Steam IDs and to verify match participation
# when a flag is submitted from inside a matchroom.
FACEIT_API_KEY=

# Optional: use a separate Data API key just for match verification.
# Falls back to FACEIT_API_KEY when unset.
FACEIT_DATA_API_KEY=

# OAuth2 client from https://developers.faceit.com → Create OAuth2 Client Id.
# FACEIT's token endpoint requires HTTP Basic client_id:client_secret, so the
# extension proxies its code exchange through /api/et/oauth/token — the secret
# must never be shipped inside the extension.
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=

# --- Ads (optional) ---
# Leave BOTH blank to run with no ads and no cookie banner.
# Fill in after your Google AdSense account is approved.
# Publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# An ad-unit "slot" id you create in the AdSense dashboard, e.g. 1234567890
NEXT_PUBLIC_ADSENSE_SLOT=
