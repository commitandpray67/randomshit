# --- Copy to .env.local and fill in ---

# Your Steam Web API key: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Postgres connection string (Supabase, Neon, or local).
# e.g. postgres://user:pass@host:5432/dbname
DATABASE_URL=

# Public base URL of this app. Used to build the Steam OpenID return URL.
# Local dev: http://localhost:3000   Production: https://your-domain.com
APP_URL=http://localhost:3000

# Random secret used to sign the session cookie.
# Generate one with:  openssl rand -hex 32
SESSION_SECRET=

# Shared secret the cron scheduler sends as `Authorization: Bearer <this>`
# to hit /api/cron/poll. Generate with:  openssl rand -hex 32
CRON_SECRET=

# --- ELO TERRORISTS extension ---
# FACEIT Data API key (server-side): https://developers.faceit.com → API Keys.
# Used to resolve nicknames → Steam IDs and to verify match participation
# when a flag is submitted from inside a matchroom.
FACEIT_API_KEY=

# Optional: use a separate Data API key just for match verification.
# Falls back to FACEIT_API_KEY when unset.
FACEIT_DATA_API_KEY=

# OAuth2 client from https://developers.faceit.com → Create OAuth2 Client Id.
# FACEIT's token endpoint requires HTTP Basic client_id:client_secret, so the
# extension proxies its code exchange through /api/et/oauth/token — the secret
# must never be shipped inside the extension.
FACEIT_CLIENT_ID=
FACEIT_CLIENT_SECRET=

# Extra hostnames this deployment should treat as its own, comma-separated.
# Sign-in returns to whichever known host the visitor arrived on, and the
# studio/overlay pages hand back browser-source URLs on that same host — so if
# the main domain is unreachable for someone (an ISP blocking its IP), a
# *.vercel.app URL still works end to end. Vercel's own VERCEL_URL and
# VERCEL_PROJECT_PRODUCTION_URL are trusted automatically; this is for any
# additional domain you point here. Unknown hosts fall back to APP_URL, so a
# spoofed Host header can't turn the Steam round-trip into an open redirect.
ALT_HOSTS=

# --- Stream overlay (Pogly-style OBS browser source) ---
# Comma-separated SteamID64s allowed to open the overlay control panel at
# /overlay. Everyone else gets a 404. Leave BLANK to disable the feature
# entirely — an empty value allows nobody, it does not allow everybody.
POGLY_ALLOWED_STEAM_IDS=

# Optional: seconds between real Steam re-checks triggered by overlay polling.
# The overlay is what makes unfriend detection live (the cron is daily), but
# this throttle stops a fast-polling browser source from hammering the Steam
# API. Default 60.
OVERLAY_SYNC_THROTTLE_SEC=60

# On first use the overlay studio (/studio) turns this list into the members
# of its first studio; after that, studio access is managed in the studio.

# SteamID64s who can open every studio at /studio, create studios for other
# streamers, and add or remove who may edit each one.
STUDIO_ADMIN_STEAM_IDS=

# Optional: the studio's own host, when it runs on a separate server
# (DEPLOY-VPS.md). Set it here on the main deployment and /studio and
# /scene/<key> redirect there. Fixed at build time: redeploy after changing it.
# Leave blank to serve the studio from this deployment.
# STUDIO_ORIGIN=https://studio.steamfriends.xyz

# --- Ads (optional) ---
# Leave BOTH blank to run with no ads and no cookie banner.
# Fill in after your Google AdSense account is approved.
# Publisher id, e.g. ca-pub-1234567890123456
NEXT_PUBLIC_ADSENSE_CLIENT=
# An ad-unit "slot" id you create in the AdSense dashboard, e.g. 1234567890
NEXT_PUBLIC_ADSENSE_SLOT=
