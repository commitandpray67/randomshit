{
  "manifest_version": 3,
  "name": "ELO TERRORISTS",
  "version": "2.0.0",
  "description": "Community FACEIT griefer database. Flag ELO terrorists — see them glow red before you accept the match.",
  "permissions": ["storage", "identity"],
  "host_permissions": [
    "https://www.faceit.com/*",
    "https://steamfriends.xyz/api/et/*",
    "https://api.faceit.com/*",
    "https://accounts.faceit.com/*",
    "https://open.faceit.com/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ELO TERRORISTS"
  },
  "content_scripts": [
    {
      "matches": ["https://www.faceit.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
